	author = {Miller, Alexander V. and Pismeniuk, Liubov V. and Duplinsky, Alexey V. and Merzlinkin, Vitaly E. and Plukchi, Aleksandr A. and Tikhonova, Kseniia A. and Nesterov, Ivan S. and Sevryukov, Dmitry O. and Levashov, Sergey D. and Fetisov, Vladimir V. and Krasnopejev, Sergei V. and Bakhshaliev, Ruslan M.},
	month = dec,
