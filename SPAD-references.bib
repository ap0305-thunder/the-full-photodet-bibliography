	keywords = {Electric fields, Sensors, Photonics, Surface treatment, Single-photon avalanche diodes, Semiconductor process modeling, Doping, back illuminated, photo detection efficiency (PDE), Silicon photomultipler (SiPM), TCAD},
	pages = {16089--16097},
