@Article{bib:CLAROIRRAD-bis,
  author   = {M. Andreotti and W. Baldini and M. Baszczykc and R. Calabrese and A. Candelori and P. Carniti and L. Cassina and A. Cotta Ramusino and P. Dorosz and M. Fiorini and A. Giachero and C. Gotti and W. Kucewicz and E. Luppi and M. Maino and R. Malaguti and S. Mattiazzo and L. Minzoni and L.L. Pappalardo and G. Pessina and L. Silvestrin and L. Tomassetti},
  title    = {Radiation hardness assurance of the CLARO8 front-end chip for the LHCb RICH detector upgrade},
  doi      = {https://doi.org/10.1016/j.nima.2017.02.035},
  issn     = {0168-9002},
  note     = {The 9th international workshop on Ring Imaging Cherenkov Detectors (RICH2016)},
  pages    = {126-128},
  url      = {https://www.sciencedirect.com/science/article/pii/S0168900217302188},
  volume   = {876},
  abstract = {The CLARO8 chip has been designed for single-photon counting in the upgraded RICH detector of the LHCb experiment at CERN. The chip has 8 channels with 5ns peaking time and a recovery time better than 25ns. Each channel is made of a charge amplifier with 2-bit settable attenuation, plus a comparator with a 6-bit settable threshold, and the configuration register is protected against Single Event Upsets by triple modular redundancy. In order to ensure stable operation of the upgraded RICH detectors over the expected lifetime of the experiment after the upgrade, the performance of the CLARO8 in high radiation fields has been assessed. These chips will be exposed, during the whole upgrade running phase, to a total ionizing dose of 200krad, a neutron fluence of 3×1012 1MeVneq/cm2 and a high energy hadrons fluence of 1.2×1012cm−2. Systematic irradiation campaigns have been performed using ions, protons and mixed-field high-energy hadron beams. This paper describes the radiation hardness campaign of the CLARO8 chips and the main results of its extensive characterisation.},
  journal  = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
  keywords = {Radiation hardness, Front-end electronics, Photodetectors},
  year     = {2017},
}

